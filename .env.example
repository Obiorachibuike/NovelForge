# ─────────────────────────────────────────────────────────────
# NovelForge Environment Configuration
# Copy to .env.local and fill in values.
# Never commit real credentials or secrets to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local development default: a SQLite file. No database server required, so
# `cp .env.example .env.local && npm run dev` works immediately.
DATABASE_URL="file:./prisma/dev.db"

# Production (and any PostgreSQL-backed dev setup) requires a postgres:// URL.
# SQLite is refused at runtime when NODE_ENV=production unless you explicitly
# set ALLOW_SQLITE_IN_PRODUCTION="true".
# DATABASE_URL="postgresql://novelforge:replace-with-db-password@localhost:5432/novelforge"
#
# Optional PostgreSQL connection pool tuning:
# PG_POOL_MAX="10"
# PG_IDLE_TIMEOUT_MS="30000"
# PG_CONNECTION_TIMEOUT_MS="10000"
# PG_SSL="require"   # "require" verifies the certificate; "no-verify" for a self-signed/managed CA

# SQLite file path (only used when DATABASE_URL is file:... or unset in development):
SQLITE_PATH="./prisma/dev.db"

# NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
# Required in production; generate with: openssl rand -base64 48
# (a placeholder or <32 characters makes every sign-in fail with "Configuration")
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — enables "Continue with Google").
# Both or neither: a half-configured pair is reported and the button is hidden.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI (optional — enables live AI generation; omit or use AI_DEMO_MODE=true for rich offline demo mode)
OPENAI_API_KEY=""
AI_TEXT_MODEL="gpt-4o-mini"
AI_FAST_MODEL="gpt-4o-mini"
AI_IMAGE_MODEL="dall-e-3"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_DEMO_MODE="true"

# ─────────────────────────────────────────────────────────────
# Hugging Face Hosted Inference (server-side only; never NEXT_PUBLIC_*)
# Architecture, operations and honest model status: docs/AI_INFERENCE.md
# ─────────────────────────────────────────────────────────────
# Fine-grained user access token with the "Make calls to Inference Providers"
# permission. Without it NovelForge stays on the OpenAI or demo backend; every
# model in /admin/ai remains "Unverified" because nothing has been checked.
HF_TOKEN=""

# Backend selection: auto | huggingface | openai
#   auto        → Hugging Face when HF_TOKEN is set, else OpenAI, else demo
#   huggingface → force hosted inference (falls back to demo without a token)
#   openai      → keep the previous OpenAI behaviour
AI_BACKEND="auto"

# Router / Hub endpoints (defaults shown)
# HF_ROUTER_BASE_URL="https://router.huggingface.co/v1"
# HF_HUB_API_BASE_URL="https://huggingface.co/api"

# Pin a provider ("hf-inference", "fal-ai", "together", …). "auto" (default)
# lets the router pick the fastest provider with automatic failover.
HF_PROVIDER="auto"

# Defaults used when the writer leaves the model selector on "Automatic".
HF_DEFAULT_TEXT_MODEL="Qwen/Qwen2.5-7B-Instruct"
HF_DEFAULT_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# Image transport: auto | openai-compatible | task-native
AI_IMAGE_TRANSPORT="auto"

# Fallback, retry and timeout policy
AI_FALLBACK_ENABLED="true"
AI_MAX_FALLBACK_ATTEMPTS="4"
AI_MAX_RETRIES_PER_MODEL="1"
AI_REQUEST_TIMEOUT_MS="120000"

# Pricing policy. The defaults are deliberately conservative:
#   AI_ALLOW_PAID_INFERENCE=false      → never call a model confirmed as paid
#   AI_REQUIRE_CONFIRMED_PRICING=true  → skip models whose pricing is unknown
# Run `npm run ai:verify` after setting HF_TOKEN to populate pricing; until then
# no model is confirmed. Set the second flag to "false" to try unverified models.
AI_ALLOW_PAID_INFERENCE="false"
AI_REQUIRE_CONFIRMED_PRICING="true"

# Registry verification (no inference unless a smoke test is requested)
AI_MODEL_HEALTH_CHECK_ENABLED="true"
AI_MODEL_HEALTH_CHECK_INTERVAL_HOURS="24"
AI_MODEL_CACHE_TTL_SECONDS="3600"
# Live image smoke tests spend credits and are slow: opt in explicitly.
AI_ALLOW_LIVE_IMAGE_HEALTH_CHECKS="false"

# Per-user hosted-inference budgets per hour (0 disables a limit)
AI_MAX_TEXT_REQUESTS_PER_USER_PER_HOUR="20"
AI_MAX_IMAGE_REQUESTS_PER_USER_PER_HOUR="5"
AI_MAX_CONCURRENT_REQUESTS="2"

# Largest image edge sent to a provider, and the completion-token ceiling
AI_MAX_IMAGE_EDGE="1024"
AI_MAX_COMPLETION_TOKENS="8000"

# AI Cost & Rate Guardrails (per user; set to 0 to disable a limit)
AI_DAILY_TOKEN_LIMIT="400000"
AI_MONTHLY_COST_LIMIT_USD="25"
AI_MAX_CONCURRENT_JOBS="2"
AI_TIMEOUT_MS="90000"

# Redis (optional — enables shared rate limiting across multiple web instances)
REDIS_URL=""

# ─────────────────────────────────────────────────────────────
# Cloudinary Cover-Image Storage (server-side only; never NEXT_PUBLIC_*)
# Selected novel cover images are permanently stored in Cloudinary under:
#   novelforge/covers/<user-id>/<novel-id>/cover_<image-id>
# ─────────────────────────────────────────────────────────────
# Default: local disk storage under DATA_DIR — works with zero external services.
STORAGE_PROVIDER="local"
#
# To store selected covers permanently in Cloudinary instead:
# STORAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-cloudinary-api-key"
# CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# CLOUDINARY_FOLDER="novelforge"

# S3 / Cloudflare R2 Storage (optional alternative for manuscript export files)
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────
# Billing & Access Control (Stripe + Admin)
# ─────────────────────────────────────────────────────────────
# Comma-separated emails that are automatically promoted to the `admin` role on
# sign-in or registration. Admins have full access and can grant/revoke free
# novel-creation access for other accounts at /admin.
ADMIN_EMAILS=""

# Set to "false" ONLY in local development to bypass the subscription check.
BILLING_REQUIRED="true"

# Stripe credentials (server-side only — never expose STRIPE_SECRET_KEY or
# STRIPE_WEBHOOK_SECRET in client code).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Recurring Stripe Price IDs mapped to NovelForge plans
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_STUDIO_MONTHLY=""

# App Metadata
NEXT_PUBLIC_APP_NAME="NovelForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
