# ─────────────────────────────────────────────────────────────
# NovelForge Environment Configuration
# Copy to .env.local and fill in values.
# Never commit real credentials or secrets to version control.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL is the primary database; required in production)
DATABASE_URL="postgresql://novelforge:replace-with-db-password@localhost:5432/novelforge"
# Optional PostgreSQL connection pool tuning:
# PG_POOL_MAX="10"
# PG_IDLE_TIMEOUT_MS="30000"
# PG_CONNECTION_TIMEOUT_MS="10000"
# PG_SSL="require"

# Optional local development / test SQLite path (only used when DATABASE_URL is file:... or unset in development):
SQLITE_PATH="./prisma/dev.db"

# NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (optional — enables "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (optional — enables live AI generation; omit or use AI_DEMO_MODE=true for rich offline demo mode)
OPENAI_API_KEY=""
AI_TEXT_MODEL="gpt-4o-mini"
AI_FAST_MODEL="gpt-4o-mini"
AI_IMAGE_MODEL="dall-e-3"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_DEMO_MODE="true"

# AI Cost & Rate Guardrails (per user; set to 0 to disable a limit)
AI_DAILY_TOKEN_LIMIT="400000"
AI_MONTHLY_COST_LIMIT_USD="25"
AI_MAX_CONCURRENT_JOBS="2"
AI_TIMEOUT_MS="90000"

# Redis (optional — enables shared rate limiting across multiple web instances)
REDIS_URL=""

# ─────────────────────────────────────────────────────────────
# Cloudinary Cover-Image Storage (server-side only; never NEXT_PUBLIC_*)
# Selected novel cover images are permanently stored in Cloudinary under:
#   novelforge/covers/<user-id>/<novel-id>/cover_<image-id>
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="novelforge"

# S3 / Cloudflare R2 Storage (optional alternative for manuscript export files)
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────
# Billing & Access Control (Stripe + Admin)
# ─────────────────────────────────────────────────────────────
# Comma-separated emails that are automatically promoted to the `admin` role on
# sign-in or registration. Admins have full access and can grant/revoke free
# novel-creation access for other accounts at /admin.
ADMIN_EMAILS=""

# Set to "false" ONLY in local development to bypass the subscription check.
BILLING_REQUIRED="true"

# Stripe credentials (server-side only — never expose STRIPE_SECRET_KEY or
# STRIPE_WEBHOOK_SECRET in client code).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Recurring Stripe Price IDs mapped to NovelForge plans
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_STUDIO_MONTHLY=""

# App Metadata
NEXT_PUBLIC_APP_NAME="NovelForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
