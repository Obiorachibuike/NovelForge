# ==== NovelForge environment ====
# Copy to .env.local (development) or configure in the Vercel dashboard.
# Nothing here is required to run the app locally: with no values set it uses
# SQLite, local disk storage, an in-process queue and clearly-labelled demo AI.

# ---- Database ----
# SQLite file path. This is the only implemented database driver today.
# NOTE: a file on Vercel is ephemeral — see docs/postgresql.md before deploying.
DATABASE_URL=file:./prisma/dev.db

# ---- Auth (NextAuth v5 / Auth.js) ----
# REQUIRED in production. Generate with:  openssl rand -base64 48
# The app refuses to start a production request when this is missing, shorter
# than 32 characters, or still the placeholder below.
AUTH_SECRET=replace-with-a-long-random-secret
# Set to false if you terminate TLS and set the canonical host yourself.
AUTH_TRUST_HOST=true
# Optional: Google sign-in. Leave BOTH blank for email + password only.
# Both must be set, or the provider is hidden (a half-configured pair is logged and ignored).
# Register this exact redirect URI in the Google Cloud console:
#   <origin>/api/auth/callback/google   (e.g. http://localhost:3000/api/auth/callback/google)
# See docs/google-signin.md for the full setup and the account-linking policy.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- AI provider (OpenAI) ----
# Leave OPENAI_API_KEY blank (or set AI_DEMO_MODE=true) to run the whole
# authoring flow with clearly-labelled demo content and no paid calls.
OPENAI_API_KEY=
AI_DEMO_MODE=true
# Model overrides (defaults shown).
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_STRUCTURED_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Timeout and retry bounds for any single provider call.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Per-user spend guards (rolling windows). 0 disables a check.
AI_DAILY_TOKEN_LIMIT=400000
AI_MONTHLY_COST_LIMIT_USD=25
AI_MAX_COMPLETION_TOKENS=8000

# ---- Storage (covers + export files) ----
# local       → <DATA_DIR>/uploads, served through the authenticated
#               /api/files/<key> route. Not persistent on Vercel.
# s3          → any S3-compatible bucket (AWS, R2, B2, MinIO). See docs/storage.md.
# cloudinary  → images only.
STORAGE_PROVIDER=local
# Local disk location (default: ./.data). Ignored by s3/cloudinary.
DATA_DIR=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Non-AWS endpoints (R2/B2/MinIO). Path style is required by MinIO and B2.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
# Set only if the bucket is fronted by a public CDN; otherwise files are
# proxied through the ownership-checked /api/files route.
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=novelforge

# ---- Background jobs ----
# inprocess → jobs run in the web process (fine for local dev / one instance).
# redis     → jobs are queued in Redis and consumed by `npm run worker`
#             (BullMQ). Requires REDIS_URL and a running worker process.
QUEUE_PROVIDER=inprocess
REDIS_URL=
# A job whose worker died is requeued after this many milliseconds.
QUEUE_STALE_JOB_MS=300000
# Worker tuning (used by `npm run worker`).
WORKER_POLL_MS=3000
WORKER_CONCURRENCY=2

# ---- Rate limits (requests per hour, per user or client IP) ----
RATE_LIMIT_AI_PER_HOUR=60
RATE_LIMIT_EDITOR_PER_HOUR=240
RATE_LIMIT_IMAGE_PER_HOUR=20
RATE_LIMIT_EXPORT_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=10

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Billing (Stripe) ----
# Optional. Without STRIPE_SECRET_KEY the app runs normally but only
# administrators and accounts an administrator has comped can create novels —
# checkout/portal/webhook endpoints answer 503 `billing_not_configured`
# instead of pretending a payment can be taken. See docs/billing.md.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (stripe listen / dashboard → Webhooks).
# Webhook bodies are only trusted after constructEvent() verifies this secret.
STRIPE_WEBHOOK_SECRET=
# Stripe *price* ids for the plans in src/lib/billing/plans.ts. Create the
# products in Stripe, then paste the recurring price ids here. A plan whose id
# is missing simply cannot be purchased yet; the pricing page says so.
STRIPE_PRICE_AUTHOR=
STRIPE_PRICE_STUDIO=

# ---- Administration ----
# Comma-separated e-mail addresses that are administrators automatically. The
# first administrator is created this way (or with `npm run admin:grant -- <email>`).
# Administrators create novels for free and can grant/revoke free novel creation
# for other accounts in the /admin console.
ADMIN_EMAILS=
