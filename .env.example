# ==== NovelForge .env.example ====
# Copy to .env and fill in values.

# ---- Database ----
# PostgreSQL is not implemented: a PostgreSQL URL requires a new database adapter.
# SQLite (local dev fallback, no pgvector — cosine similarity is computed in code):
DATABASE_URL=file:./prisma/dev.db

# ---- Auth.js (NextAuth v5) ----
# Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
# Leave the Google OAuth keys blank if you only want email/password auth.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- AI Providers ----
# When OPENAI_API_KEY is left blank the app runs in AI_DEMO_MODE and returns
# clearly-labelled mock responses so you can walk the full flow without keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
IMAGE_GENERATION_MODEL=dall-e-3
AI_DEMO_MODE=true
AI_TIMEOUT_MS=90000

# ---- Storage (generated covers + export files) ----
# "local" stores to ./public/uploads/ on a persistent Node server.
# Cloudinary/S3 adapters are not implemented; local storage cannot be used on Vercel.
STORAGE_PROVIDER=local
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Background jobs ----
# "inprocess" runs jobs in-process (dev / single-instance).
# "redis" uses BullMQ and requires a Redis connection string.
QUEUE_PROVIDER=inprocess
REDIS_URL=redis://localhost:6379

# ---- Exports ----
# Absolute URL of the app, used for generating PDF/EPUB covers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
